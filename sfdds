   "source": [
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar dataset\n",
    "superstore = pd.read_csv(\"superstore.csv\", encoding='ISO-8859-1')\n",
    "superstore['Order Date'] = pd.to_datetime(superstore['Order Date'])\n",
    "superstore['Ship Date'] = pd.to_datetime(superstore['Ship Date'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gr\u00e1fica de barras: ventas por categor\u00eda\n",
    "bar_fig = px.bar(superstore.groupby('Category')['Sales'].sum().reset_index(),\n",
    "                 x='Category', y='Sales', text='Sales',\n",
    "                 title='Ventas Totales por Categor\u00eda')\n",
    "bar_fig.update_traces(texttemplate='%{text:.2s}', textposition='outside')\n",
    "bar_fig.update_layout(uniformtext_minsize=8, uniformtext_mode='hide')\n",
    "bar_fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Crear columna YearMonth\n",
    "superstore['YearMonth'] = superstore['Order Date'].dt.to_period('M').astype(str)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gr\u00e1fico de l\u00edneas con Plotly Express\n",
    "line_data = superstore.groupby('YearMonth')['Sales'].sum().reset_index()\n",
    "line_fig = px.line(line_data, x='YearMonth', y='Sales', title='Evoluci\u00f3n de Ventas (Plotly Express)')\n",
    "line_fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gr\u00e1fico de l\u00edneas con Plotly Go y media m\u00f3vil\n",
    "line_data['Sales_MA3'] = line_data['Sales'].rolling(3).mean()\n",
    "go_fig = go.Figure()\n",
    "go_fig.add_trace(go.Scatter(x=line_data['YearMonth'], y=line_data['Sales'],\n",
    "                             mode='lines', name='Ventas'))\n",
    "go_fig.add_trace(go.Scatter(x=line_data['YearMonth'], y=line_data['Sales_MA3'],\n",
    "                             mode='lines', name='Media M\u00f3vil (3)', line=dict(color='red')))\n",
    "go_fig.update_layout(title='Evoluci\u00f3n de Ventas con Media M\u00f3vil (Plotly Go)')\n",
    "go_fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gr\u00e1fico treemap\n",
    "treemap_data = superstore.groupby(['Region', 'Category', 'Sub-Category'])['Sales'].sum().reset_index()\n",
    "treemap_fig = px.treemap(treemap_data, path=['Region', 'Category', 'Sub-Category'], values='Sales',\n",
    "                         title='Ventas por Regi\u00f3n, Categor\u00eda y Subcategor\u00eda')\n",
    "treemap_fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gr\u00e1fico de dispersi\u00f3n\n",
    "scatter_fig = px.scatter(superstore, x='Sales', y='Profit', color='Discount',\n",
    "                         title='Relaci\u00f3n entre Ventas y Ganancias con Descuento')\n",
    "scatter_fig.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gr\u00e1fico coropl\u00e9tico\n",
    "country_sales = superstore.groupby('Country')['Sales'].sum().reset_index()\n",
    "map_fig = px.choropleth(country_sales, locations='Country', locationmode='country names',\n",
    "                        color='Sales', title='Ventas Totales por Pa\u00eds',\n",
    "                        color_continuous_scale=px.colors.sequential.Plasma)\n",
    "map_fig.show()"
   ]
  }
