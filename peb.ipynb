import pandas as pd
import plotly.express as px
import plotly.graph_objects as go

# Cargar dataset
superstore = pd.read_csv("superstore.csv", encoding='ISO-8859-1')
superstore['Order Date'] = pd.to_datetime(superstore['Order Date'])
superstore['Ship Date'] = pd.to_datetime(superstore['Ship Date'])

# Gráfica de barras: ventas por categoría
bar_fig = px.bar(superstore.groupby('Category')['Sales'].sum().reset_index(),
                 x='Category', y='Sales', text='Sales',
                 title='Ventas Totales por Categoría')
bar_fig.update_traces(texttemplate='%{text:.2s}', textposition='outside')
bar_fig.update_layout(uniformtext_minsize=8, uniformtext_mode='hide')
bar_fig.show()

# Crear columna YearMonth
superstore['YearMonth'] = superstore['Order Date'].dt.to_period('M').astype(str)

# Gráfico de líneas con Plotly Express
line_data = superstore.groupby('YearMonth')['Sales'].sum().reset_index()
line_fig = px.line(line_data, x='YearMonth', y='Sales', title='Evolución de Ventas (Plotly Express)')
line_fig.show()

# Gráfico de líneas con Plotly Go y media móvil
line_data['Sales_MA3'] = line_data['Sales'].rolling(3).mean()
go_fig = go.Figure()
go_fig.add_trace(go.Scatter(x=line_data['YearMonth'], y=line_data['Sales'],
                             mode='lines', name='Ventas'))
go_fig.add_trace(go.Scatter(x=line_data['YearMonth'], y=line_data['Sales_MA3'],
                             mode='lines', name='Media Móvil (3)', line=dict(color='red')))
go_fig.update_layout(title='Evolución de Ventas con Media Móvil (Plotly Go)')
go_fig.show()

# Gráfico treemap
treemap_data = superstore.groupby(['Region', 'Category', 'Sub-Category'])['Sales'].sum().reset_index()
treemap_fig = px.treemap(treemap_data, path=['Region', 'Category', 'Sub-Category'], values='Sales',
                         title='Ventas por Región, Categoría y Subcategoría')
treemap_fig.show()

# Gráfico de dispersión
scatter_fig = px.scatter(superstore, x='Sales', y='Profit', color='Discount',
                         title='Relación entre Ventas y Ganancias con Descuento')
scatter_fig.show()

# Gráfico coroplético
country_sales = superstore.groupby('Country')['Sales'].sum().reset_index()
map_fig = px.choropleth(country_sales, locations='Country', locationmode='country names',
                        color='Sales', title='Ventas Totales por País',
                        color_continuous_scale=px.colors.sequential.Plasma)
map_fig.show()
